# Media Refiner 配置模板
# 将本文件复制为 .env 并填入实际值
# cp config/.env.example config/.env

# === Emby ===
REFINER_EMBY_HOST=http://your-emby-host:8096
REFINER_EMBY_API_KEY=your_emby_api_key

# === MoviePilot（可选，用于搜索下载）===
REFINER_MOVIEPILOT_URL=
REFINER_MOVIEPILOT_TOKEN=

# === 影巢 HDHive（可选，用于搜索高质量片源）===
REFINER_HDHIVE_API_KEY=
REFINER_HDHIVE_MODE=openapi
REFINER_SYMEDIA_URL=
REFINER_SYMEDIA_TOKEN=
REFINER_SYMEDIA_COOKIE=
REFINER_SYMEDIA_CLOUD_TYPE=channel_115
REFINER_SYMEDIA_PARENT_ID=

# === 115 网盘（可选，用于转存）===
REFINER_CLOUD115_COOKIE=
REFINER_CLOUD115_FOLDER_ID=0

# === CloudDrive2（可选，用于转存后刷新挂载目录缓存）===
REFINER_CLOUDDRIVE_URL=
REFINER_CLOUDDRIVE_TOKEN=

# === 排除的媒体库 ID（逗号分隔，可选）===
# 留空=扫描所有电影库。填写 Emby 媒体库 ItemId（如 739854,442766）
REFINER_EXCLUDE_LIBRARY_IDS=

# === 定时扫描（小时，0=关闭）===
REFINER_SCAN_SCHEDULE=0

# === 全局代理（影巢 + TG 共用）===
REFINER_PROXY=

# === Telegram 通知 ===
REFINER_TG_BOT_TOKEN=
REFINER_TG_CHAT_ID=
REFINER_TG_NOTIFY_EVENTS=
